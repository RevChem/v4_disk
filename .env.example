# Токен Cropwise API (обязателен для скриптов)
CROPWISE_API_TOKEN=

# Намолот (1С). Пароль только здесь, в коде его нет.
NAMOLOT_BASE_URL=http://10.0.1.5/hpp_elevator_new/hs/ground/report
NAMOLOT_USERNAME=Сводка
NAMOLOT_PASSWORD=

# Зачётный вес овощей. Пустые логин/пароль — те же, что у намолота.
NET_WEIGHT_BASE_URL=http://10.0.1.5/agro_buh/hs/NetWeight/GetWeight
NET_WEIGHT_USERNAME=
NET_WEIGHT_PASSWORD=

# Опционально: cookie браузера для UI-отчётов (/machines/reports/work.json)
# Скопируйте из DevTools после входа в operations.cropwise.com (кука _cropio_ses)
# CROPWISE_SESSION_COOKIE=_cropio_ses=...

# Опционально
CROPWISE_BASE_URL=https://operations.cropwise.com/api/v3
CROPWISE_SEASON_YEAR=2026
CORS_ORIGINS=*

# Порты Docker
WEB_HOST_PORT=8080
API_HOST_PORT=6757

# Observability — docker/observability/docker-compose.yml (отдельный стек)
GRAFANA_HOST_PORT=3000
GRAFANA_BIND_HOST=127.0.0.1
LOKI_HOST_PORT=3100
LOKI_BIND_HOST=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Сеть основного compose (COMPOSE_PROJECT_NAME_default)
SVODKI_APP_NETWORK=v3_disk_default
LOG_LEVEL=INFO

# Auth / infra (docker-compose подставляет postgres/redis/rabbitmq)
JWT_SECRET=change-me-in-production
BOOTSTRAP_DEVELOPER_EMAIL=svodki@chistai.ru
BOOTSTRAP_DEVELOPER_PASSWORD=задайте_надёжный_пароль
BOOTSTRAP_DEVELOPER_USERNAME=developer
CELERY_ENABLED=true
DATABASE_URL=postgresql+psycopg2://svodki:svodki@postgres:5432/svodki

# SMTP (Yandex: порт 465 + SMTP_USE_SSL=true)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Генерация PDF/Excel (параллельно сводок; 0 = auto)
# Не ставьте 1, если нужна параллельная генерация нескольких сводок.
SVODKI_DEDICATED_HEAVY_REPORT_LANES=1
# ВАЖНО: при 0 (auto) параллелизм не бывает ниже 4 — SVODKI_GENERATION_AUTO_MAX_WORKERS
# ниже 4 ничего не меняет. Чтобы реально снизить RAM, задайте явное число (например 2):
# скриптов одновременно = это число + по одной дорожке сводок 1 и 2.
SVODKI_GENERATION_MAX_WORKERS=0
SVODKI_GENERATION_AUTO_MAX_WORKERS=2
# 0 (по умолчанию): каждая сводка сама ходит в Cropwise, без svodki_prefetch.py
SVODKI_USE_PREFETCH_DATA=0
# 1: опциональный JSON-кэш GET внутри одной пачки сводок (sitecustomize)
# SVODKI_USE_API_CACHE=1
# Одновременных LibreOffice (каждый — отдельный процесс на сотни МБ; 1–2 для экономии RAM)
SVODKI_PDF_CONVERT_MAX_WORKERS=3

# Celery: тяжёлые задачи (генерация, proverka) — в отдельном worker-heavy, одна за раз.
# Пусто = всё в одной очереди (старое поведение). Менять синхронно у api/beat/worker-ов.
CELERY_HEAVY_QUEUE=heavy
# WORKER_CONCURRENCY=2
# WORKER_HEAVY_CONCURRENCY=1
# WORKER_HEAVY_MEM_LIMIT=8g
# WORKER_MEM_LIMIT=1g

# Проверка (proverka): параллель subprocess-сводок в Celery worker (1–4)
PROVERKA_MAX_WORKERS=4
# Сколько часов хранить cookie Cropwise в «Нарушениях» (не срок _cropio_ses на стороне Cropwise)
PROVERKA_MONITORING_COOKIE_TTL_HOURS=24
# JWT access token (мин); refresh — 14 дней по умолчанию
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI-разбор proverka (DeepSeek + LangChain)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash — самая дёшево/лёгкая; deepseek-v4-pro — дороже, для сложных задач
PROVERKA_AI_MODEL=deepseek-flash
PROVERKA_AI_THINKING=disabled
PROVERKA_AI_MAX_OUTPUT_TOKENS=2048
PROVERKA_AI_ENABLED=1
PROVERKA_AI_MAX_TASK_ERRORS=20
PROVERKA_AI_MAX_FINDINGS=15
PROVERKA_AI_TIMEOUT_SEC=120

# --- Хранилище заданий (SQLite, uploads/.task_store/store.sqlite) ---
# Бэкенд синхронизирует его один раз перед пачкой (задания + строки площади), сводки читают только своё окно.
# Память: тематические сводки — сотни МБ или меньше; сводки 1 и 2 (весь сезон) — ~1,6 ГБ (JSON сезона целиком).
SVODKI_TASK_STORE_PRESYNC=true
# Аварийный возврат на прежние pickle-файлы: SVODKI_TASK_STORE_BACKEND=pickle
# Хранить все поля заданий (без белого списка): SVODKI_STORE_FIELDS=all
# raw (полный JSON) хранится у заданий и строк площади. Новое поле в сводке -> python tools/gen_store_fields.py && python utils/shared/svodki_task_store.py rebuild
# Суточные факты (SQLite): TaskStore.daily_facts(); сверка на реальных данных: python tools/verify_daily_facts.py
# Пересчёт без API: python utils/shared/svodki_task_store.py rebuild-facts
# Кэш справочников (fields, history_items, inventory_history_items, machines, agro_operations, crops,
# field_groups, group_folders): <store>/refs.sqlite. Бэкенд прогревает типовые наборы перед пачкой,
# остальные кэшируются при первом обращении. Отключить: SVODKI_REF_CACHE_DISABLE=1; срок жизни: SVODKI_REF_CACHE_TTL_SEC=3600
# Параллелизм пачки при включённом хранилище: тематические сводки теперь занимают 100–300 МБ.
# Пробуйте SVODKI_GENERATION_MAX_WORKERS=3, затем 4; следите за пиком RAM и ответами 429 от Cropwise.
# Сводка 1 после синхронизации ждёт доноров 3–8 (fast-path); чтобы она шла параллельно с ними,
# проверьте SVODKI_REPORT1_STANDALONE=1 (все данные из API/кэша, без доноров) — сверить цифры.
