# Токен Cropwise API (обязателен для скриптов)
CROPWISE_API_TOKEN=

# Опционально: cookie браузера для UI-отчётов (/machines/reports/work.json)
# Скопируйте из DevTools после входа в operations.cropwise.com (кука _cropio_ses)
# CROPWISE_SESSION_COOKIE=_cropio_ses=...

# Опционально
CROPWISE_BASE_URL=https://operations.cropwise.com/api/v3
CROPWISE_SEASON_YEAR=2026
CORS_ORIGINS=*

# Порты Docker
WEB_HOST_PORT=8080
API_HOST_PORT=6757

# Observability — docker/observability/docker-compose.yml (отдельный стек)
GRAFANA_HOST_PORT=3000
GRAFANA_BIND_HOST=127.0.0.1
LOKI_HOST_PORT=3100
LOKI_BIND_HOST=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Сеть основного compose (COMPOSE_PROJECT_NAME_default)
SVODKI_APP_NETWORK=v3_disk_default
LOG_LEVEL=INFO

# Auth / infra (docker-compose подставляет postgres/redis/rabbitmq)
JWT_SECRET=change-me-in-production
BOOTSTRAP_DEVELOPER_EMAIL=svodki@chistai.ru
BOOTSTRAP_DEVELOPER_PASSWORD=задайте_надёжный_пароль
BOOTSTRAP_DEVELOPER_USERNAME=developer
CELERY_ENABLED=true
DATABASE_URL=postgresql+psycopg2://svodki:svodki@postgres:5432/svodki

# SMTP (Yandex: порт 465 + SMTP_USE_SSL=true)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 21:00 MSK — proverka за вчера+сегодня, Excel на почту
PROVERKA_EVENING_MAIL_ENABLED=1
PROVERKA_EVENING_MAIL_TO=i.hamitov@chistai.ru,baikievrenat@gmail.com

# Генерация PDF/Excel (параллельно сводок; 0 = auto)
# Не ставьте 1, если нужна параллельная генерация нескольких сводок.
SVODKI_DEDICATED_HEAVY_REPORT_LANES=1
SVODKI_GENERATION_MAX_WORKERS=0
SVODKI_GENERATION_AUTO_MAX_WORKERS=2
# 0 (по умолчанию): каждая сводка сама ходит в Cropwise, без svodki_prefetch.py
SVODKI_USE_PREFETCH_DATA=0
# 1: опциональный JSON-кэш GET внутри одной пачки сводок (sitecustomize)
# SVODKI_USE_API_CACHE=1
SVODKI_PDF_CONVERT_MAX_WORKERS=3

# Проверка (proverka): параллель subprocess-сводок в Celery worker (1–4)
PROVERKA_MAX_WORKERS=4
# Сколько часов хранить cookie Cropwise в «Нарушениях» (не срок _cropio_ses на стороне Cropwise)
PROVERKA_MONITORING_COOKIE_TTL_HOURS=24
# JWT access token (мин); refresh — 14 дней по умолчанию
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI-разбор proverka (DeepSeek + LangChain)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash — самая дёшево/лёгкая; deepseek-v4-pro — дороже, для сложных задач
PROVERKA_AI_MODEL=deepseek-flash
PROVERKA_AI_THINKING=disabled
PROVERKA_AI_MAX_OUTPUT_TOKENS=2048
PROVERKA_AI_ENABLED=1
PROVERKA_AI_MAX_TASK_ERRORS=20
PROVERKA_AI_MAX_FINDINGS=15
PROVERKA_AI_TIMEOUT_SEC=120
