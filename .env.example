# Токен Cropwise API (обязателен для скриптов)
CROPWISE_API_TOKEN=

# Намолот (1С). Пароль только здесь, в коде его нет.
NAMOLOT_BASE_URL=http://10.0.1.5/hpp_elevator_new/hs/ground/report
NAMOLOT_USERNAME=Сводка
NAMOLOT_PASSWORD=

# Зачётный вес овощей. Пустые логин/пароль — те же, что у намолота.
NET_WEIGHT_BASE_URL=http://10.0.1.5/agro_buh/hs/NetWeight/GetWeight
NET_WEIGHT_USERNAME=
NET_WEIGHT_PASSWORD=

# Опционально: cookie браузера для UI-отчётов (/machines/reports/work.json)
# Скопируйте из DevTools после входа в operations.cropwise.com (кука _cropio_ses)
# CROPWISE_SESSION_COOKIE=_cropio_ses=...

# Опционально
CROPWISE_BASE_URL=https://operations.cropwise.com/api/v3
# Номер сезона считается автоматически (с июля — следующий календарный год). Задавайте только
# если нужно зафиксировать вручную: значение получат и api, и worker.
# CROPWISE_SEASON_YEAR=2027
CORS_ORIGINS=*

# Порты Docker
WEB_HOST_PORT=8080
API_HOST_PORT=6757

# Observability — docker/observability/docker-compose.yml (отдельный стек)
GRAFANA_HOST_PORT=3000
GRAFANA_BIND_HOST=127.0.0.1
LOKI_HOST_PORT=3100
LOKI_BIND_HOST=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Сеть основного compose (COMPOSE_PROJECT_NAME_default)
SVODKI_APP_NETWORK=v3_disk_default
LOG_LEVEL=INFO

# Auth / infra (docker-compose подставляет postgres/redis/rabbitmq)
JWT_SECRET=change-me-in-production
BOOTSTRAP_DEVELOPER_EMAIL=svodki@chistai.ru
BOOTSTRAP_DEVELOPER_PASSWORD=задайте_надёжный_пароль
BOOTSTRAP_DEVELOPER_USERNAME=developer
CELERY_ENABLED=true
DATABASE_URL=postgresql+psycopg2://svodki:svodki@postgres:5432/svodki

# SMTP (Yandex: порт 465 + SMTP_USE_SSL=true)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Генерация PDF/Excel (параллельно сводок; 0 = auto)
# Не ставьте 1, если нужна параллельная генерация нескольких сводок.
SVODKI_DEDICATED_HEAVY_REPORT_LANES=1
# ВАЖНО: при 0 (auto) параллелизм не бывает ниже 4 — SVODKI_GENERATION_AUTO_MAX_WORKERS
# ниже 4 ничего не меняет. Чтобы реально снизить RAM, задайте явное число (например 2):
# скриптов одновременно = это число + по одной дорожке сводок 1 и 2.
SVODKI_GENERATION_MAX_WORKERS=0
SVODKI_GENERATION_AUTO_MAX_WORKERS=2
# 0 (по умолчанию): каждая сводка сама ходит в Cropwise, без svodki_prefetch.py
SVODKI_USE_PREFETCH_DATA=0
# 1: опциональный JSON-кэш GET внутри одной пачки сводок (sitecustomize)
# SVODKI_USE_API_CACHE=1
# Одновременных LibreOffice (каждый — отдельный процесс на сотни МБ; 1–2 для экономии RAM)
SVODKI_PDF_CONVERT_MAX_WORKERS=3

# Celery: тяжёлые задачи (генерация, proverka) — в отдельном worker-heavy, одна за раз.
# Пусто = всё в одной очереди (старое поведение). Менять синхронно у api/beat/worker-ов.
CELERY_HEAVY_QUEUE=heavy
# WORKER_CONCURRENCY=2
# WORKER_HEAVY_CONCURRENCY=1
# WORKER_HEAVY_MEM_LIMIT=8g
# WORKER_MEM_LIMIT=1g

# Проверка (proverka): параллель subprocess-сводок в Celery worker (1–4)
PROVERKA_MAX_WORKERS=4
# Сколько часов хранить cookie Cropwise в «Нарушениях» (не срок _cropio_ses на стороне Cropwise)
PROVERKA_MONITORING_COOKIE_TTL_HOURS=24
# JWT access token (мин); refresh — 14 дней по умолчанию
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI-разбор proverka (DeepSeek + LangChain)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash — самая дёшево/лёгкая; deepseek-v4-pro — дороже, для сложных задач
PROVERKA_AI_MODEL=deepseek-flash
PROVERKA_AI_THINKING=disabled
PROVERKA_AI_MAX_OUTPUT_TOKENS=2048
PROVERKA_AI_ENABLED=1
PROVERKA_AI_MAX_TASK_ERRORS=20
PROVERKA_AI_MAX_FINDINGS=15
PROVERKA_AI_TIMEOUT_SEC=120

# --- Хранилище заданий (SQLite, uploads/.task_store/store.sqlite) ---
# Бэкенд синхронизирует его один раз перед пачкой (задания + строки площади), сводки читают только своё окно.
# Память: тематические сводки — сотни МБ или меньше; сводки 1 и 2 (весь сезон) — ~1,6 ГБ (JSON сезона целиком).
SVODKI_TASK_STORE_PRESYNC=true
# Аварийный возврат на прежние pickle-файлы: SVODKI_TASK_STORE_BACKEND=pickle
# Хранить все поля заданий (без белого списка): SVODKI_STORE_FIELDS=all
# raw (полный JSON) хранится у заданий и строк площади. Новое поле в сводке -> python tools/gen_store_fields.py && python utils/shared/svodki_task_store.py rebuild
# Суточные факты (SQLite): TaskStore.daily_facts(); сверка на реальных данных: python tools/verify_daily_facts.py
# Пересчёт без API: python utils/shared/svodki_task_store.py rebuild-facts
# Сводка 1, колонка «Обработано за сутки» (лист «Выработка техники»): shadow — сверка в лог, daily — читать из фактов
# SVODKI_DAILY_FACTS_SHADOW=1
# SVODKI_DAILY_FACTS_DAILY=1
# --- Инкрементальные сезонные данные (хранилище переживает сутки; пересчитывается только изменившееся) ---
# Всё ниже по умолчанию выключено/старое поведение. Включать по шагам, на реальных данных НЕ проверялось.
# 1) Источник дельты хранилища: filter (по умолчанию, updated_at_gt_eq) | auto (API «Changed objects», при сбое -> filter)
#    | verify (оба пути, объединение, расхождения в лог — включить на неделю) | changes (только /changes, ошибка если недоступен)
# SVODKI_STORE_DELTA_SOURCE=verify
# SVODKI_CHANGES_API=auto            # off | auto | verify | force — глобально для клиента /changes
# SVODKI_CHANGES_LIMIT=1000          # limit запроса /changes (окно делится пополам, пока не влезет в страницу)
# 2) Связи заданий с агрооперациями (machine_task_agro_operation_mapping_items + agro_operations) хранятся в sqlite
#    и обновляются дельтой вместо полной перезагрузки каждый запуск. Выключить: SVODKI_TASK_LINKS=0
# SVODKI_LINKS_RECENT_DAYS=7           # задания последних N суток всегда перечитываются
# SVODKI_LINKS_HARD_REFRESH_HOURS=72   # полное перечитывание связей раз в N часов (страховка)
# SVODKI_LINKS_MARGIN_SEC=3600
# 3) Кэш вкладов заданий в сезонные суммы сводки 2: off (по умолчанию) | shadow (полный пересчёт + сверка с кэшем в лог)
#    | on (считаются только новые/изменённые и «горячие» задания). Рекомендуемый путь: shadow ~неделя -> on.
# SVODKI_SEASON_CACHE=shadow
# SVODKI_SEASON_CACHE_HOT_DAYS=3       # задания, закончившиеся позже N суток до отчётной смены, не кэшируются
# SVODKI_SEASON_CACHE_AUDIT=0.02       # доля попаданий в кэш, выборочно пересчитываемых и сверяемых (в on)
# Внимание: схема хранилища v5. Старый код (v4) при запуске пересоздаёт БД — перезапускайте бэкенд и воркеры вместе.
# Кэш справочников (fields, history_items, inventory_history_items, machines, agro_operations, crops,
# field_groups, group_folders): <store>/refs.sqlite. Бэкенд прогревает типовые наборы перед пачкой,
# остальные кэшируются при первом обращении. Отключить: SVODKI_REF_CACHE_DISABLE=1; срок жизни: SVODKI_REF_CACHE_TTL_SEC=3600
# Параллелизм пачки при включённом хранилище: тематические сводки теперь занимают 100–300 МБ.
# Пробуйте SVODKI_GENERATION_MAX_WORKERS=3, затем 4; следите за пиком RAM и ответами 429 от Cropwise.
# Сводка 1: рекомендуется v2 (единый preload данных)
# SVODKI_REPORT1_SCRIPT=1_main_ammonium_v2.py
# REPORT1_V2_CONCURRENCY=40
# REPORT1_V2_MTFMI_CONCURRENCY=40
# Сводка 1 после синхронизации ждёт доноров 3–8 (fast-path); чтобы она шла параллельно с ними,
# проверьте SVODKI_REPORT1_STANDALONE=1 (все данные из API/кэша, без доноров) — сверить цифры.

# --- Очередь сводки 1 (standalone hybrid) ---
# Ранний старт сводки 1 (не хвост после 3–8): по умолчанию вкл. при SVODKI_REPORT1_STANDALONE=1
# SVODKI_REPORT1_RUN_FIRST=1
# SVODKI_REPORT1_RUN_FIRST=0 — fast-path: сводка 1 после доноров 3–8 (как раньше)
# По умолчанию (вариант А): сводка 1 стартует ПЕРВОЙ в общей очереди, а не хвостом; уборка подставляется из 10/11.
# Вариант Б: SVODKI_REPORT1_HYBRID_OWN_LANE=1 — своя дорожка, уборку сводка 1 считает сама (гибрид выключен).
# SVODKI_REPORT1_HYBRID_OWN_LANE=0
# Замер пика RAM и 429 для подбора воркеров: python3 backend/scripts/mem_sampler.py --out mem.tsv --log <лог воркера>
# Справочники: дельта + /versions вместо полной выгрузки; полная — раз в SVODKI_REF_FULL_REFRESH_SEC (86400).
# SVODKI_REF_INCREMENTAL=1  SVODKI_REF_DELTA_MARGIN_SEC=300

# --- Встроенные проверки данных Cropwise (svodki_sanity): культура, площадь, задания ---
# В расчёт не вмешиваются: печатают строки DATA_CHECK при завершении сводки. Выключить: SVODKI_SANITY=0
# SVODKI_SANITY=1
# SVODKI_SANITY_JSON=/app/uploads/sanity.json          # дополнительно сохранить итог в JSON
# SVODKI_SANITY_FIELD_TOL=1.10     # covered_area ≤ площадь_поля × TOL + SVODKI_SANITY_FIELD_ABS (0.5 га)
# SVODKI_SANITY_HOURLY_REL=0.02    # допуск Σ covered_area_hourly к covered_area (доля) / _ABS (0.10 га)
# SVODKI_SANITY_TASK_REL=0.02      # допуск Σ строк к task.covered_area / _ABS (0.5 га)
# SVODKI_SANITY_MAX_HA_H=250       # га/ч на строку; выше — AREA_RATE
# SVODKI_SANITY_MAX_TASK_H=48      # длительность задания, ч
# SVODKI_SANITY_NO_HARVEST_CROPS=пар,чистый пар,черный пар,чёрный пар,сидеральный пар,залежь
# WT_UNMAPPED: задание с площадью, чей work_type_id нет в группах редактора планов.
# SVODKI_SANITY_WT_MIN_HA=1.0
# SVODKI_SANITY_WT_IGNORE=7,8   # id, которые не считать нарушением (транспорт и пр.)
# Сверка «Итого» в xlsx ↔ расчёт (DATA_CHECK FILE_TOTAL). Отключить: SVODKI_SANITY_FILE=0
# SVODKI_SANITY_FILE=1
# SVODKI_SANITY_FILE_REL=0.02   # допуск к max(расчёт, файл)
# SVODKI_SANITY_FILE_ABS=0.5    # га
# Скрипт может вывести DATA_CHECK_CALC_TOTAL=123.45 или вызвать svodki_sanity.emit_calc_total_ha()
# CROSS_OP: publish_cross_op_snapshot() в конце сводки; finalize — после пачки (генерация/proverka)

# Проверка «пометка фирмы в поле Namolot ≠ папка Cropwise» (окно на дашборде)
FIELD_FIRM_CHECK_INTERVAL_SEC=10800
FIELD_FIRM_ALERT_ADMIN_ONLY=false
