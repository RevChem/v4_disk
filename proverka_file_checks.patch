+def _book(tmp_path, crop_rows, firm_rows, total):
+    wb = Workbook()
+    ws = wb.active
+    ws.title = "5.0 Уборка"
+    _make_sheet(ws, crop_rows, firm_rows, total)
+    path = tmp_path / "2. report_crop_works_compact_2026-09-25.xlsx"
+    wb.save(path)
+    return path
